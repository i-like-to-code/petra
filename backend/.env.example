# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI
MONGO_URI=mongodb://127.0.0.1:27017/petracement_db

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Initial Admin Portal account (created on startup only if no admin exists)
ADMIN_EMAIL=admin@petracement.com
ADMIN_PASSWORD=change_this_admin_password
